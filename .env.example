# Copy to .env and fill in. Never commit .env.

# --- Claude API ---------------------------------------------------------------
# Leave empty if you use `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=
ANSWER_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
# Opus 5.5 defaults to effort "medium"; set it explicitly so runs are comparable.
ANSWER_EFFORT=medium

# --- Qdrant -------------------------------------------------------------------
# Option A: Docker server (docker compose up -d) -> dashboard at http://localhost:6333/dashboard
QDRANT_URL=http://localhost:6333
# Option B: embedded local mode, no server. Leave QDRANT_URL empty and use this path.
QDRANT_PATH=data/qdrant_local
COLLECTION=foss_docs

# --- Embeddings (fastembed, ONNX models from Hugging Face) ---------------------
# Already downloaded into .cache/fastembed: pass cache_dir=FASTEMBED_CACHE when you load them.
FASTEMBED_CACHE=.cache/fastembed
# Chosen model (1024 dims, 2.2 GB); MiniLM cuts input at 128 tokens, too short for our chunks:
DENSE_MODEL=intfloat/multilingual-e5-large
# Fast alternative (384 dims, 0.2 GB), for comparison only: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25
